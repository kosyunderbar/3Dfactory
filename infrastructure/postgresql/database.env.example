# Local Java execution; template only. Use four different generated passwords.
# Provisioning needs the four PASSWORD variables. Apps also need URL/USERNAME values.
INGESTION_DB_URL=jdbc:postgresql://127.0.0.1:5432/ingestion_db
INGESTION_DB_USERNAME=ingestion_app
INGESTION_DB_PASSWORD=CHANGE_ME_INGESTION_APP
INGESTION_MIGRATION_USERNAME=ingestion_migrator
INGESTION_MIGRATION_PASSWORD=CHANGE_ME_INGESTION_MIGRATOR
OPERATIONS_DB_URL=jdbc:postgresql://127.0.0.1:5432/operations_db
OPERATIONS_DB_USERNAME=operations_app
OPERATIONS_DB_PASSWORD=CHANGE_ME_OPERATIONS_APP
OPERATIONS_MIGRATION_USERNAME=operations_migrator
OPERATIONS_MIGRATION_PASSWORD=CHANGE_ME_OPERATIONS_MIGRATOR
